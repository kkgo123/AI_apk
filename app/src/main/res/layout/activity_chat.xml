<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  activity_chat.xml - 聊天界面布局（升级版）
  ============================================================
  升级内容：
  1. 附件面板支持6种发送方式（拍照/录像/音频通话/视频通话/图片/文件）
  2. 搜索栏（可展开/收起）
  3. 工具栏增加清空对话和搜索按钮
  4. 附件面板使用网格布局，每项带文字标签
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soul_background">

    <!-- ============ 顶部标题栏 ============ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/soul_surface"
        app:title="💬 对话"
        app:titleTextColor="@color/soul_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 右侧操作按钮区 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <!-- 搜索按钮 -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="搜索"
                android:layout_marginEnd="8dp" />

            <!-- 清空对话按钮 -->
            <ImageButton
                android:id="@+id/btnClearAll"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="清空对话" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ============ 搜索栏（默认隐藏） ============ -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/soul_surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_bg"
            android:hint="搜索对话内容..."
            android:textColorHint="@color/soul_text_secondary"
            android:textColor="@color/soul_text_primary"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnSearchConfirm"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="搜索"
            android:layout_marginStart="8dp" />

        <ImageButton
            android:id="@+id/btnSearchClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="关闭搜索"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- ============ 搜索结果提示 ============ -->
    <TextView
        android:id="@+id/tvSearchResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/soul_surface_light"
        android:textColor="@color/soul_text_secondary"
        android:textSize="12sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ 消息列表 ============ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSearchResult"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ 底部输入区域 ============ -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/soul_surface"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ============ 附件工具面板（升级版 - 2行3列网格） ============ -->
        <GridLayout
            android:id="@+id/gridAttach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:padding="12dp"
            android:background="@drawable/attach_panel_bg"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <!-- 📷 拍照 -->
            <LinearLayout
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拍照"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 🎥 录像 -->
            <LinearLayout
                android:id="@+id/btnRecordVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎥"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录像"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 🖼️ 图片 -->
            <LinearLayout
                android:id="@+id/btnImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼️"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图片"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 📞 音频通话 -->
            <LinearLayout
                android:id="@+id/btnAudioCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音频通话"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 📹 视频通话 -->
            <LinearLayout
                android:id="@+id/btnVideoCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📹"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频通话"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 📁 文件 -->
            <LinearLayout
                android:id="@+id/btnFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文件"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </GridLayout>

        <!-- ============ 输入行 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 附件展开按钮（+号） -->
            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="更多" />

            <!-- 文本输入框 -->
            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@color/chat_input_bg"
                android:hint="@string/chat_input_hint"
                android:textColorHint="@color/soul_text_secondary"
                android:textColor="@color/soul_text_primary"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:maxLines="4"
                android:inputType="textMultiLine"
                android:imeOptions="actionSend" />

            <!-- 语音按钮 -->
            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="语音" />

            <!-- TTS自动朗读开关按钮 -->
            <ImageButton
                android:id="@+id/btnTtsToggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="自动朗读"
                android:alpha="0.4"
                android:layout_marginStart="2dp" />

            <!-- 发送按钮 -->
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="发送"
                android:layout_marginStart="4dp" />

            <!-- 终止生成按钮（默认隐藏，AI生成回复时显示） -->
            <ImageButton
                android:id="@+id/btnStopGenerate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/stop_button_bg"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="终止生成"
                android:visibility="gone"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- ============ 录音状态提示（默认隐藏，按住语音按钮时显示） ============ -->
        <TextView
            android:id="@+id/tvRecordingHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🎤 录音中...松开结束"
            android:textColor="@color/soul_accent"
            android:textSize="13sp"
            android:paddingVertical="6dp"
            android:background="@color/soul_surface_light"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
