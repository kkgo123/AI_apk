<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  activity_add_character.xml - 添加/编辑角色界面
  ============================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soul_background">

    <!-- 顶部标题栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/soul_surface"
        app:title="创建角色"
        app:titleTextColor="@color/soul_primary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 表单内容（可滚动） -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 头像区域 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="60dp"
                    app:cardBackgroundColor="@color/soul_surface_light"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/soul_primary"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="角色头像" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 更换头像按钮 -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabChangeAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:src="@android:drawable/ic_menu_camera"
                    android:contentDescription="更换头像"
                    app:backgroundTint="@color/soul_accent"
                    app:tint="@android:color/white"
                    app:fabSize="mini" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="点击更换头像"
                android:textSize="12sp"
                android:textColor="@color/soul_text_secondary"
                android:layout_marginTop="8dp" />

            <!-- 姓名输入 -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="角色姓名"
                app:hintTextColor="@color/soul_accent"
                app:boxStrokeColor="@color/soul_primary"
                app:boxBackgroundColor="@color/soul_surface"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/soul_text_primary"
                    android:textSize="16sp"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 性别选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="性别"
                android:textSize="14sp"
                android:textColor="@color/soul_text_secondary"
                android:layout_marginTop="20dp"
                android:layout_marginStart="4dp" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="男"
                    android:textColor="@color/soul_text_primary"
                    android:buttonTint="@color/soul_primary" />

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="女"
                    android:textColor="@color/soul_text_primary"
                    android:buttonTint="@color/soul_primary" />

                <RadioButton
                    android:id="@+id/rbBiMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="双性男"
                    android:textColor="@color/soul_text_primary"
                    android:textSize="13sp"
                    android:buttonTint="@color/soul_primary" />

                <RadioButton
                    android:id="@+id/rbBiFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="双性女"
                    android:textColor="@color/soul_text_primary"
                    android:textSize="13sp"
                    android:buttonTint="@color/soul_primary" />
            </RadioGroup>

            <!-- 年龄输入 -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="年龄"
                app:hintTextColor="@color/soul_accent"
                app:boxStrokeColor="@color/soul_primary"
                app:boxBackgroundColor="@color/soul_surface"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/soul_text_primary"
                    android:textSize="16sp"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 角色设定 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="角色设定"
                android:textSize="14sp"
                android:textColor="@color/soul_text_secondary"
                android:layout_marginTop="20dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="描述角色的性格、背景故事、说话风格等..."
                app:hintTextColor="@color/soul_accent"
                app:boxStrokeColor="@color/soul_primary"
                app:boxBackgroundColor="@color/soul_surface"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPersonality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/soul_text_primary"
                    android:textSize="14sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="5"
                    android:maxLines="10"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 保存按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:text="💾 保存角色卡"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/soul_primary"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
