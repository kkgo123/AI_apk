<?xml version="1.0" encoding="utf-8"?>
<!--
  学习界面布局 - LearningActivity
  包含三个Tab：TXT导入 / 网址抓取 / 智能爬取
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soul_background">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/soul_surface"
        app:title="🧠 学习中心"
        app:titleTextColor="@color/soul_primary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 学习统计区 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLearningStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/soul_surface"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="12dp">

            <!-- 知识数量 -->
            <TextView
                android:id="@+id/tvKnowledgeCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:padding="8dp"
                android:text="📚 知识: 0"
                android:textColor="@color/soul_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/soul_background"
                android:gravity="center"/>

            <!-- 常识数量 -->
            <TextView
                android:id="@+id/tvCommonSenseCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:padding="8dp"
                android:text="💡 常识: 0"
                android:textColor="@color/soul_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/soul_background"
                android:gravity="center"/>

            <!-- 概念节点 -->
            <TextView
                android:id="@+id/tvConceptNodes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:text="🔗 概念: 0"
                android:textColor="@color/soul_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/soul_background"
                android:gravity="center"/>

            <!-- 代码量 -->
            <TextView
                android:id="@+id/tvCodeLines"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:text="💻 代码: 0行"
                android:textColor="@color/soul_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/soul_background"
                android:gravity="center"/>
        </GridLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 预留入口按钮区 -->
    <LinearLayout
        android:id="@+id/layoutImportEntries"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardLearningStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImageImport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🖼️ 图片"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoImport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="🎬 视频"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFileImport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="📁 文件"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- Tab布局 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/soul_surface"
        app:tabTextColor="@color/soul_text_secondary"
        app:tabSelectedTextColor="@color/soul_primary"
        app:tabIndicatorColor="@color/soul_primary"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        app:layout_constraintTop_toBottomOf="@id/layoutImportEntries"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ViewPager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
