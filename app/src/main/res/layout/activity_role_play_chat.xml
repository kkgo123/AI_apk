<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  activity_role_play_chat.xml - 角色扮演聊天界面
  ============================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soul_background">

    <!-- 顶部角色信息栏 -->
    <LinearLayout
        android:id="@+id/layoutCharHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/soul_surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="?attr/homeAsUpIndicator"
            android:contentDescription="返回" />

        <!-- 角色头像 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/soul_surface_light"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivCharAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="角色头像" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 角色名称和性别 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvCharName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/soul_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCharGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/soul_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 清空聊天按钮 -->
        <ImageButton
            android:id="@+id/btnClearChat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="清空聊天" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/chat_divider"
        app:layout_constraintTop_toBottomOf="@id/layoutCharHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 消息列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部输入区域 -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/soul_surface"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 文本输入框 -->
        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@color/chat_input_bg"
            android:hint="说点什么..."
            android:textColorHint="@color/soul_text_secondary"
            android:textColor="@color/soul_text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:maxLines="4"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend" />

        <!-- 发送按钮 -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="发送"
            android:layout_marginStart="8dp" />

        <!-- 终止生成按钮（默认隐藏） -->
        <ImageButton
            android:id="@+id/btnStopGenerate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/stop_button_bg"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="终止生成"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
