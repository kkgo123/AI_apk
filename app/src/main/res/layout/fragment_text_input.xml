<?xml version="1.0" encoding="utf-8"?>
<!--
  输入文本 Fragment 布局 - 直接输入文字学习入库
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soul_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 说明卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/soul_surface"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✏️ 输入文本学习"
                    android:textColor="@color/soul_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="直接输入或粘贴文字内容，系统将自动拆解为知识单元并学习入库。\n\n支持任意文本：文章、笔记、代码、对话记录等。"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 文本输入区 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/soul_surface"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/soul_primary"
                    app:hintTextColor="@color/soul_primary"
                    android:hint="输入要学习的文本内容"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:textColor="@color/soul_text_primary"
                        android:textSize="14sp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:minLines="8"
                        android:maxLines="20"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 学习按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLearnText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="🧠 学习入库"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/soul_primary"/>

                <!-- 学习状态 -->
                <TextView
                    android:id="@+id/tvLearnStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/soul_accent"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 学习结果统计卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTextLearnStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/soul_surface"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 学习结果"
                    android:textColor="@color/soul_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTextLearnedNeurons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧠 神经元数量: 0 个"
                    android:textColor="@color/soul_neuron_active"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvTextKeywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔑 关键词数量: 0 个"
                    android:textColor="@color/soul_accent"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvTextKeywordEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="关键词条: 0 条"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvTextConceptNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔗 概念节点数量: 0 个"
                    android:textColor="@color/soul_primary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvTextSummaryIndex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 概要搜引数量: 0 条"
                    android:textColor="@color/soul_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
